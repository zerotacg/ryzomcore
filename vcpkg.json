{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ryzom-core",
  "version-string": "4.1.0.0",
  "dependencies": [
    "giflib",
    "libogg",
    "libvorbis",
    "openal-soft"
  ],
  "overrides": [
    {
      "name": "openal-soft",
      "version": "1.24.3"
    }
  ],
  "default-features": [
    "nel"
  ],
  "features": {
    "nel": {
      "description": "Builds NeL",
      "dependencies": [
        {
          "name": "ryzom-core",
          "default-features": false,
          "features": [
            "nel-3d",
            "nel-gui",
            "nel-net",
            "nel-web",
            "testing"
          ]
        }
      ]
    },
    "nel-3d": {
      "description": "Builds with 3D support",
      "dependencies": [
        {
          "name": "ryzom-core",
          "default-features": false,
          "features": [
            "nel-misc"
          ]
        },
        {
          "name": "freetype",
          "default-features": false,
          "features": [
            "error-strings"
          ]
        },
        "opengl"
      ]
    },
    "nel-gui": {
      "description": "Builds with GUI support",
      "dependencies": [
        "lua",
        "luabind",
        "qt5"
      ]
    },
    "nel-misc": {
      "description": [],
      "dependencies": [
        "libpng",
        "libjpeg-turbo",
        {
          "name": "libxml2",
          "default-features": false,
          "features": [
            "zlib"
          ]
        },
        "zlib"
      ]
    },
    "nel-net": {
      "description": "Builds with NET support",
      "dependencies": []
    },
    "nel-web": {
      "description": "Builds with WEB support",
      "dependencies": [
        {
          "name": "ryzom-core",
          "default-features": false,
          "features": [
            "nel-misc"
          ]
        },
        "curl",
        {
          "name": "libxml2",
          "default-features": false,
          "features": [
            "zlib"
          ]
        },
        "openssl"
      ]
    },
    "nelns": {
      "description": "Builds NeL Network Services",
      "dependencies": [
        {
          "name": "ryzom-core",
          "default-features": false,
          "features": [
            "nel-misc",
            "nel-net"
          ]
        }
      ]
    },
    "ryzom": {
      "description": "Builds Ryzom",
      "dependencies": [
        {
          "name": "ryzom-core",
          "default-features": false,
          "features": [
            "ryzom-client",
            "ryzom-server",
            "ryzom-tools"
          ]
        }
      ]
    },
    "ryzom-client": {
      "description": "Builds Ryzom Client",
      "dependencies": [
        {
          "name": "ryzom-core",
          "default-features": false,
          "features": [
            "nel-3d",
            "nel-misc"
          ]
        },
        "curl",
        "luabind",
        "openssl",
        "zlib"
      ]
    },
    "ryzom-server": {
      "description": "Builds Ryzom Services",
      "dependencies": []
    },
    "ryzom-tools": {
      "description": "Builds Ryzom Tools",
      "dependencies": []
    },
    "ffmpeg": {
      "description": "Builds with ffmpeg support",
      "dependencies": [
        "ffmpeg"
      ]
    },
    "msquic": {
      "description": "Builds with msquic",
      "dependencies": [
        "msquic"
      ]
    },
    "testing": {
      "description": "Builds tests",
      "dependencies": [
        "cpptest",
        "gtest"
      ]
    }
  }
}
