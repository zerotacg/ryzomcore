@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_@PROJECT_NAME@_supported_components @package_components@)
set(_@PROJECT_NAME@_3d_dependencies Freetype)
set(_@PROJECT_NAME@_3d_component_dependencies misc)
set(_@PROJECT_NAME@_georges_dependencies LibXml2)
set(_@PROJECT_NAME@_georges_component_dependencies misc)
set(_@PROJECT_NAME@_gui_dependencies CURL Lua Luabind LibXml2)
set(_@PROJECT_NAME@_gui_component_dependencies 3d misc web)
set(_@PROJECT_NAME@_ligo_dependencies LibXml2)
set(_@PROJECT_NAME@_ligo_component_dependencies misc)
set(_@PROJECT_NAME@_logic_dependencies LibXml2)
set(_@PROJECT_NAME@_logic_component_dependencies misc net)
set(_@PROJECT_NAME@_misc_dependencies ZLIB)
set(_@PROJECT_NAME@_net_component_dependencies misc)
set(_@PROJECT_NAME@_pacs_component_dependencies misc)
set(_@PROJECT_NAME@_pipeline_component_dependencies misc)
set(_@PROJECT_NAME@_sound_dependencies Vorbis)
set(_@PROJECT_NAME@_sound_component_dependencies misc)
set(_@PROJECT_NAME@_sound_dependencies LibXml2)
set(_@PROJECT_NAME@_sound_component_dependencies 3d georges ligo misc)
set(_@PROJECT_NAME@_web_dependencies CURL OpenSSL LibXml2)
set(_@PROJECT_NAME@_web_component_dependencies misc)

macro(find_component _comp)
    foreach(_dependency IN ITEMS ${_@PROJECT_NAME@_${_comp}_dependencies})
        find_dependency(${_dependency})
    endforeach()

    foreach(_dependency IN ITEMS ${_@PROJECT_NAME@_${_comp}_component_dependencies})
        find_component(${_dependency})
    endforeach()

    include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-${_comp}-targets.cmake")
    set(@PROJECT_NAME@_${_comp}_FOUND TRUE)
endmacro()

foreach(_comp ${@PROJECT_NAME@_FIND_COMPONENTS})
    if (NOT _comp IN_LIST _@PROJECT_NAME@_supported_components)
        set(@PROJECT_NAME@_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
    else ()
        find_component(${_comp})
    endif()
endforeach()

check_required_components(@PROJECT_NAME@)
